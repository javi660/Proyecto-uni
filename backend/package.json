{
  "name": "sgssu-backend",
  "version": "0.1.0",
  "description": "API REST del Sistema de Gestión de Servicios y Solicitudes Universitarias (SGSSU)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,json src/server.js",
    "test": "jest --runInBand",
    "check:db": "node scripts/check-db.js",
    "db:apply": "node scripts/db-apply.js",
    "db:reset": "node scripts/db-apply.js --reset",
    "db:migrate": "node scripts/db-migrate.js",
    "db:verify": "node scripts/db-verify.js",
    "test:unit": "jest --runInBand",
    "test:integration": "node scripts/test-db-setup.js && jest --runInBand --config jest.integration.config.js",
    "docs:acceptance": "node scripts/generate-acceptance-doc.js",
    "user:create": "node scripts/create-user.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  }
}
