# SGSSU - Variables de entorno del backend
# Completa los valores localmente o en el panel del hosting; no guardes secretos en Git.
PORT=4000
NODE_ENV=development

# Frontend local con Vite y frontend publicado en Render
CORS_ORIGINS=http://localhost:5173,https://proyecto-uni-1.onrender.com

# Cadenas de PostgreSQL; usa una base separada para las pruebas de integración
DATABASE_URL=
TEST_DATABASE_URL=
DB_SSL=require
DB_SSL_CA=
DB_POOL_MAX=10

# Genera dos secretos distintos de al menos 32 caracteres con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# En produccion debe ser true
COOKIE_SECURE=false
BCRYPT_COST=12
TRUST_PROXY=0

# Configuracion opcional de Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=sgssu-adjuntos

# Contrasenas opcionales de usuarios de demostracion
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_DEFAULT=
