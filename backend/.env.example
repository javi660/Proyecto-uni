# ============================================================
# SGSSU - Backend - Variables de entorno
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo ".env" al repositorio.
# ============================================================

# --- Servidor ---
PORT=4000
NODE_ENV=development

# Orígenes permitidos por CORS, separados por comas (frontend en desarrollo: Vite)
CORS_ORIGINS=http://localhost:5173

# --- Base de datos (Supabase = PostgreSQL alojado) ---
# Supabase > Project Settings > Database > Connection string > URI
#   - Si tu red NO tiene IPv6, usa la cadena del "Session pooler" (puerto 5432).
#   - No agregues "?sslmode=..." a la URL: el SSL se controla con DB_SSL.
#   - Si la contraseña tiene caracteres especiales (@ : / # ?), codifícala (URL-encode).
DATABASE_URL=postgresql://postgres.yrqwcxbfcqxiawiimmbv:Javier3105%2A2005@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Base de datos SEPARADA para pruebas de integración (nunca la de datos reales)
TEST_DATABASE_URL=postgresql://postgres.yrqwcxbfcqxiawiimmbv:Javier3105%2A2005@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Modo SSL de la conexión a PostgreSQL:
#   require = cifrado sin verificar el certificado (recomendado para Supabase)
#   verify  = cifrado verificando el certificado (opcionalmente con DB_SSL_CA)
#   disable = sin SSL (solo para PostgreSQL local)
DB_SSL=require
# Ruta a un certificado CA (solo con DB_SSL=verify). Supabase lo ofrece en Database Settings.
DB_SSL_CA=
DB_POOL_MAX=10

# --- Autenticación (se usan desde la Fase 3; mínimo 32 caracteres cada uno) ---
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=123456789123456789123456789123456789123456789123456789123456789123456789123456789
JWT_REFRESH_SECRET=12345678912345678912345678912345678912345678912345678123456789123456789123456789123456789123456789123456789
# true en producción (HTTPS; en producción es obligatorio). En desarrollo local déjalo en false.
COOKIE_SECURE=false
# Costo de bcrypt para guardar contraseñas (12 recomendado)
BCRYPT_COST=12
# Número de proxies de confianza delante del backend (0 = ninguno). Ajusta si despliegas detrás de un balanceador.
TRUST_PROXY=0

# --- /

# --- Supabase Storage para adjuntos (se usa desde la Fase 6) ---
SUPABASE_URL=https://yrqwcxbfcqxiawiimmbv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
STORAGE_BUCKET=sgssu-adjuntos

# --- Datos de demostración (se usan desde la Fase 2/5; NO escribas contraseñas reales aquí si compartes el archivo) ---
DEMO_PASSWORD_ADMIN=
DEMO_PASSWORD_DEFAULT=