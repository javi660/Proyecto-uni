# SGSSU - Frontend - Variables de entorno (solo desarrollo)
# Copia este archivo a ".env" si necesitas cambiar el destino del proxy.
# IMPORTANTE: las variables VITE_* quedan visibles en el navegador. NUNCA pongas secretos aquí.

# URL del backend al que Vite reenvía las peticiones /api en desarrollo
VITE_API_PROXY_TARGET=http://localhost:4000

# URL de API para producción (opcional; este es el valor predeterminado)
# VITE_API_URL=https://proyecto-uni-2eqo.onrender.com/api
